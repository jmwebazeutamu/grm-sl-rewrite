{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"],
            "ziggy": ["vendor/tightenco/ziggy"]
        },
        "strict": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": true,
        "resolveJsonModule": true,
        "types": ["node", "vite/client", "vitest/globals"]
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.vue"
    ],
    "exclude": ["node_modules", "public", "vendor"]
}
